{
  "indentWidth": 2,
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/target",
    "nts",
    "prettier",
    "src/vendor",
    "src/shims",
    "src/sites.json",
    "src/generated",
    "src/prettier-plugins",
    "tests/specs",
    "tests/samples",
    "wasm/bin",
    "wasm/obj",
    ".github/workflows/*.generated.yml"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.101.0",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/prettier@0.73.1"
  ]
}
