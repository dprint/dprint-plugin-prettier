{
  "indentWidth": 2,
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/target",
    "prettier",
    "src/vendor",
    "src/shims",
    "src/generated",
    "src/prettier-plugins",
    "tests/specs",
    "wasm/bin",
    "wasm/obj",
    ".github/workflows/*.generated.yml"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.22.1",
    "npm:@dprint/prettier@0.70.0/plugin.json@97c0dccf54ed5b7343e7a3f6418e77bd80afcd2b74beed3a632689d47e392ddc"
  ]
}
